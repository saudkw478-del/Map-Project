# همسة نصّية عشوائية (#w = 1..8)
execute if score #w nh_story matches 1 run tellraw @s {"text":"همسٌ من الرمال: لا تدعوا الفانوس ينطفئ...","color":"dark_gray","italic":true}
execute if score #w nh_story matches 2 run tellraw @s {"text":"همسٌ بعيد: ألف ليلةٍ وليلة... ما زلنا ننتظر.","color":"dark_gray","italic":true}
execute if score #w nh_story matches 3 run tellraw @s {"text":"صوتٌ خافت: الأختام... الأختام السبعة...","color":"dark_gray","italic":true}
execute if score #w nh_story matches 4 run tellraw @s {"text":"الريح تهمس باسمكم: هيّا، لقد اقتربتم.","color":"dark_gray","italic":true}
execute if score #w nh_story matches 5 run tellraw @s {"text":"همسٌ في الظلام: لا تخافوا، الفانوس معكم.","color":"dark_gray","italic":true}
execute if score #w nh_story matches 6 run tellraw @s {"text":"من بعيد: مدينةٌ من نحاس... تحلم بكم.","color":"dark_gray","italic":true}
execute if score #w nh_story matches 7 run tellraw @s {"text":"الرمل يهمس: من يبقى مع أصحابه لا يضيع أبدًا.","color":"dark_gray","italic":true}
execute if score #w nh_story matches 8 run tellraw @s {"text":"همسةٌ دافئة: أنتم أشجع مما تظنّون.","color":"dark_gray","italic":true}
