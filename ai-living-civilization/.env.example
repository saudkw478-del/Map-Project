# انسخ هذا الملف باسم .env وعدّل القيم. لا ترفع .env على GitHub أبداً.

PORT=3000
LOG_LEVEL=info

# مكان حفظ قاعدة البيانات (داخل Docker يكون /app/data)
DATA_DIR=./data

# مزود الذكاء الاصطناعي:
#   fake   = موديل وهمي بدون مفتاح (للتجربة)  <-- الافتراضي
#   openai = أي API متوافق مع OpenAI (مثل Gemini)
LLM_PROVIDER=fake

# رابط Gemini المتوافق مع OpenAI
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# مفتاحك (من Google AI Studio). اتركه فاضي مع الموديل الوهمي.
LLM_API_KEY=
# اسم الموديل. أسماء الموديلات تتغير، تأكد من AI Studio ما زال Flash المجاني بهذا الاسم.
LLM_MODEL=gemini-2.5-flash

# رمز لأوامر الإدارة (يتحط في الخطوات الجاية). اكتب أي نص طويل وعشوائي.
ADMIN_TOKEN=
